# App
APP_NAME=dcomp
export APP_HOST=0.0.0.0
export STAGE=local

# Database
export DB_USERNAME=postgres
export DB_PASSWORD=postgres
export DB_DATABASE=dcomp_dev
export DB_HOSTNAME=localhost

# Cache service
export REDIS_HOST=localhost
export REDIS_PASS=123456

# Misc
export UPLOADS_PATH="priv/static/uploads/"
export MIRROR_DIR="priv/mirrors"
export MIX_ENV=dev
export PHX_SERVER=true
export MIX_TEST_PARTITION=1

# Pg Admnin
export PGADMIN_DEFAULT_EMAIL=admin@dcomp.com
export PGADMIN_DEFAULT_PASSWORD=123456

# Remote environments sessions
DEV_USER=some-user
DEV_HOST=some-host
DEV_PORT=22
STAGE_USER=some-user
STAGE_HOST=some-host
STAGE_PORT=22

# Prod sync (make sync.prod): uses a key file (path only, never the key itself)
PROD_HOST=some-host
PROD_PORT=22
PROD_SSH_KEY=./.ssh/prod_dokku
PROD_PG_SERVICE=some-pg-service
PROD_REDIS_SERVICE=some-redis-service
